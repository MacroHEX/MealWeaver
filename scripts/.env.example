# Configuración de los scripts de smoke test.
# Copiar a `scripts/.env` y completar valores reales. NO committear `.env`
# (ya está cubierto por `.env*` en .gitignore).

# ─── test-prod-smoke.{sh,ps1} ─────────────────────────────────────────
# URL del backend a probar.
BASE=https://meal-weaver.vercel.app

# Credenciales de un usuario REAL existente (login, no se registra).
TEST_EMAIL=tu@email.com
TEST_PASSWORD=tu_password_aca

# ─── test-mobile-api.{sh,ps1} ─────────────────────────────────────────
# Solo usa BASE (default http://localhost:3000). El usuario se registra
# nuevo cada run con email mobile-test-<timestamp>@example.com, así que
# no necesita TEST_EMAIL/TEST_PASSWORD.
